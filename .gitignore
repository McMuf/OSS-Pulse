# --- secrets ---
.env
.env.local
*.env

# --- Python ---
backend/.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/

# --- data ---
# The ingested DuckDB file IS committed (Stage 3 CI writes it back to main
# on a schedule) so a deployed backend can serve fresh data without its own
# database. Only ignore DuckDB's transient WAL/tmp files.
backend/data/*.duckdb.wal
backend/data/*.duckdb.tmp
data/*.parquet
backend/data/*.parquet

# --- Node / Next.js ---
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.turbo/
frontend/next-env.d.ts
frontend/CLAUDE.md
frontend/AGENTS.md

# --- dev server logs ---
*_out.log
*_err.log

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
